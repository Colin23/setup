#!/usr/bin/env bash
set -euo pipefail
# 90-dev-quality — Developer quality tools (linting, formatting, testing)
#
# Installs: shellcheck, shfmt, bats
# Verify:   shellcheck --version, shfmt --version, bats -v

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/common"

module_header "90-dev-quality" "Dev quality tools: shellcheck, shfmt, bats"

require_os arch ubuntu debian macos

# ── Install ──
log_info "Installing shellcheck, shfmt, bats..."
case "$SETUP_OS" in
    arch)
        pkg_install shellcheck shfmt bats
        ;;
    ubuntu | debian)
        pkg_install shellcheck
        # shfmt may not be in default repos on older Ubuntu
        if ! has_cmd shfmt; then
            log_warn "shfmt not in apt repos — installing via Go or snap may be needed"
        fi
        # bats
        if ! has_cmd bats; then
            pkg_install bats || log_warn "bats not available via apt"
        fi
        ;;
    macos)
        pkg_install shellcheck shfmt bats-core
        ;;
esac

# ── Verify ──
log_info "Verifying dev quality tools..."
for cmd in shellcheck shfmt bats; do
    if has_cmd "$cmd"; then
        log_success "$cmd found"
    else
        log_warn "$cmd not found"
    fi
done
