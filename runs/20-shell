#!/usr/bin/env bash
set -euo pipefail
# 20-shell — Shell setup
#
# Installs: zsh, starship, oh-my-zsh, zsh-autosuggestions, zsh-syntax-highlighting, carapace-bin
# Verify:   zsh --version, starship --version, carapace --version, plugin dirs exist

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/common"

module_header "20-shell" "Shell: zsh, starship, oh-my-zsh, plugins, carapace"

require_os arch ubuntu debian macos

# ── zsh ──
log_info "Installing zsh..."
pkg_install zsh

# ── Set zsh as default shell (idempotent) ──
current_shell="$(basename "$SHELL")"
if [[ "$current_shell" != "zsh" ]]; then
    log_info "Changing default shell to zsh..."
    zsh_path="$(command -v zsh)"
    run_cmd sudo chsh -s "$zsh_path" "${USER:-$(whoami)}"
else
    log_info "Default shell is already zsh"
fi

# ── starship prompt ──
log_info "Installing starship..."
if [[ "$SETUP_OS" == "arch" ]]; then
    pkg_install starship
else
    # Cross-platform vendor installer fallback
    if ! has_cmd starship; then
        run_cmd sh -c "$(curl -fsSL https://starship.rs/install.sh)" -- --yes
    else
        log_info "starship already installed"
    fi
fi

# ── oh-my-zsh ──
if [[ ! -d "${ZSH:-$HOME/.oh-my-zsh}" ]]; then
    log_info "Installing oh-my-zsh..."
    run_cmd sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
else
    log_info "oh-my-zsh already installed"
fi

ZSH_CUSTOM="${ZSH_CUSTOM:-${ZSH:-$HOME/.oh-my-zsh}/custom}"

# ── zsh-autosuggestions (oh-my-zsh plugin) ──
if [[ ! -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ]]; then
    log_info "Installing zsh-autosuggestions plugin..."
    run_cmd git clone --depth 1 https://github.com/zsh-users/zsh-autosuggestions "$ZSH_CUSTOM/plugins/zsh-autosuggestions"
else
    log_info "zsh-autosuggestions already installed"
fi

# ── zsh-syntax-highlighting (oh-my-zsh plugin) ──
if [[ ! -d "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" ]]; then
    log_info "Installing zsh-syntax-highlighting plugin..."
    run_cmd git clone --depth 1 https://github.com/zsh-users/zsh-syntax-highlighting "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting"
else
    log_info "zsh-syntax-highlighting already installed"
fi

# ── carapace-bin (shell completions) ──
log_info "Installing carapace..."
if [[ "$SETUP_OS" == "arch" ]]; then
    if has_cmd paru || has_cmd yay; then
        aur_install carapace-bin
    else
        log_warn "carapace: skipping — no AUR helper available (install paru or yay first)"
    fi
elif [[ "$SETUP_OS" == "macos" ]]; then
    pkg_install carapace
else
    log_warn "carapace: manual install required on $SETUP_OS"
fi

# ── Verify ──
log_info "Verifying shell setup..."
for cmd in zsh starship; do
    if has_cmd "$cmd"; then
        log_success "$cmd found"
    else
        log_warn "$cmd not found"
    fi
done

if has_cmd carapace; then
    log_success "carapace found"
else
    log_warn "carapace not found"
fi

for plugin in zsh-autosuggestions zsh-syntax-highlighting; do
    if [[ -d "$ZSH_CUSTOM/plugins/$plugin" ]]; then
        log_success "oh-my-zsh plugin: $plugin installed"
    else
        log_warn "oh-my-zsh plugin: $plugin missing"
    fi
done
