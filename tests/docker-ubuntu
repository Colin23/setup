#!/usr/bin/env bash
set -euo pipefail
# tests/docker-ubuntu — Ubuntu Docker smoke tests (proxy for KDE Neon)
#
# Tests: fresh install, idempotency, drift recovery
# Usage: ./tests/docker-ubuntu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

IMAGE="ubuntu:24.04"
SKIP="git-ssh,dotfiles,firewall,browser"
RUN_CMD="./run --skip $SKIP"

log() { echo -e "\n\033[1m── $1 ──\033[0m"; }

log "Ubuntu Docker Smoke Tests (KDE Neon proxy)"

# ── Test 1: Fresh install ──
log "Test 1: Fresh install"
docker run --rm -v "$PROJECT_DIR":/setup:ro "$IMAGE" bash -c \
    "apt-get update && apt-get install -y sudo && cp -r /setup /tmp/setup && cd /tmp/setup && $RUN_CMD"

# ── Test 2: Idempotency ──
log "Test 2: Idempotency (back-to-back run)"
docker run --rm -v "$PROJECT_DIR":/setup:ro "$IMAGE" bash -c \
    "apt-get update && apt-get install -y sudo && cp -r /setup /tmp/setup && cd /tmp/setup && \
     $RUN_CMD && \
     echo '── IDEMPOTENCY RUN ──' && \
     $RUN_CMD"

# ── Test 3: Drift recovery ──
log "Test 3: Drift recovery (remove bat, rerun)"
docker run --rm -v "$PROJECT_DIR":/setup:ro "$IMAGE" bash -c \
    "apt-get update && apt-get install -y sudo && cp -r /setup /tmp/setup && cd /tmp/setup && \
     $RUN_CMD && \
     echo '── REMOVING bat TO SIMULATE DRIFT ──' && \
     sudo apt-get remove -y bat && \
     echo '── DRIFT RECOVERY RUN ──' && \
     $RUN_CMD"

log "All Ubuntu Docker tests passed ✓"
