#!/usr/bin/env bash
set -euo pipefail
# scripts/dev-setup — Install development dependencies for this project
#
# Ensures shellcheck and shfmt are available for linting and testing.
# Safe to rerun (idempotent).
#
# Usage: ./scripts/dev-setup

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/common"

log_step "Dev Environment Setup"

MISSING=()
for cmd in shellcheck shfmt; do
    if ! has_cmd "$cmd"; then
        MISSING+=("$cmd")
    else
        log_success "$cmd already installed"
    fi
done

if [[ ${#MISSING[@]} -eq 0 ]]; then
    log_success "All dev tools present — nothing to do."
    exit 0
fi

log_info "Installing missing tools: ${MISSING[*]}"

case "$SETUP_OS" in
    arch)
        pkg_install "${MISSING[@]}"
        ;;
    ubuntu | debian)
        pkg_install "${MISSING[@]}"
        ;;
    macos)
        pkg_install "${MISSING[@]}"
        ;;
    *)
        log_error "Unsupported OS: $SETUP_OS"
        exit 1
        ;;
esac

# ── Verify ──
log_step "Verification"
STILL_MISSING=()
for cmd in shellcheck shfmt; do
    if has_cmd "$cmd"; then
        log_success "$cmd ready"
    else
        log_warn "$cmd still not available"
        STILL_MISSING+=("$cmd")
    fi
done

if [[ ${#STILL_MISSING[@]} -gt 0 ]]; then
    log_warn "Some tools need manual installation: ${STILL_MISSING[*]}"
    exit 1
fi

log_success "Dev environment ready."
